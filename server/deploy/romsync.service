[Unit]
Description=romsync server and admin dashboard
After=network.target

[Service]
Type=simple
User=romsync
Group=romsync
StateDirectory=romsync
UMask=0077
Environment=HOME=/var/lib/romsync
ExecStart=/usr/local/bin/romsync-core -config /var/lib/romsync/romsync.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/romsync/roms

[Install]
WantedBy=multi-user.target
